<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_trombinoscope_member" name="Trombinoscope Member">

        <section class="trombinoscope-member s_features_grid" data-trombinoscope-row="3" data-trombinoscope-col="3" data-trombinoscope="">
            <div class="container">
                <div class="row mb-3">
                    <div class="col-md-10 offset-md-1">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fa fa-search"></i>
                                    </span>
                                    <input type="text" class="form-control trombinoscope-search" placeholder="Search for a member..." aria-label="Search for a member"/>
                                    <div class="dropdown">
                                        <button class="btn btn-outline-secondary dropdown-toggle trombinoscope-filter-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-filter="all">
                                            All
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item trombinoscope-filter-option" href="#" data-filter="all">All</a></li>
                                            <li><a class="dropdown-item trombinoscope-filter-option" href="#" data-filter="contact">Contact Names</a></li>
                                            <li><a class="dropdown-item trombinoscope-filter-option" href="#" data-filter="company">Company Names</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="dropdown w-100">
                                    <button class="btn btn-outline-primary dropdown-toggle w-100 trombinoscope-tag-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-tag="all">
                                        <i class="fa fa-tags me-2"></i>All Tags
                                    </button>
                                    <ul class="dropdown-menu trombinoscope-tag-dropdown w-100">
                                        <li><a class="dropdown-item trombinoscope-tag-option" href="#" data-tag="all">All Tags</a></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-1 d-flex align-items-center justify-content-center">
                                <div class="form-check">
                                    <input class="form-check-input trombinoscope-sort-checkbox" type="checkbox" id="alphabeticalSort"/>
                                    <label class="form-check-label" for="alphabeticalSort" title="Sort alphabetically">
                                        <i class="fa fa-sort-alpha-asc"></i>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="s_nb_grid s_nb_column_fixed">
                    <div class="row trombinoscope-row gx-1 mb-2 justify-content-center">
                        <div class="col-3 trombinoscope-card m-1" data-detail=''>
                            <figure class="figure placeholder-glow">
                                <div class="placeholder bg-secondary rounded trombinoscope-img-placeholder"></div>
                                <figcaption class="figure-caption">
                                    <span class="placeholder col-8"></span>
                                </figcaption>
                            </figure>
                        </div>
                        <div class="col-3 trombinoscope-card m-1" data-detail=''>
                            <figure class="figure placeholder-glow">
                                <div class="placeholder bg-secondary rounded trombinoscope-img-placeholder"></div>
                                <figcaption class="figure-caption">
                                    <span class="placeholder col-6"></span>
                                </figcaption>
                            </figure>
                        </div>
                        <div class="col-3 trombinoscope-card m-1" data-detail=''>
                            <figure class="figure placeholder-glow">
                                <div class="placeholder bg-secondary rounded trombinoscope-img-placeholder"></div>
                                <figcaption class="figure-caption">
                                    <span class="placeholder col-7"></span>
                                </figcaption>
                            </figure>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </template>

    <template id="s_trombinoscope_options" inherit_id="website.snippet_options">
        <xpath expr="//div[@data-js='Box']" position="before">
            <div data-js="TrombinoscopeMemberOptions" data-selector=".trombinoscope-member">
                <we-select string="Trombinoscope" class="trombinoscope-selection" data-reload="/">
                    <we-button data-select-trombinoscope="" data-select-trombinoscope-name="None" data-reload="/" class="trombinoscope-selection">None</we-button>
                </we-select>
                <div>
                    <we-range class="o_we_sublevel_1 trombi-option-row" string="Row" data-min="2" data-step="1" data-max="25" data-trombinoscope-row="" data-display-range-value="true"/>
                    <we-range class="o_we_sublevel_1 trombi-option-col" string="Column" data-min="2" data-step="1" data-max="5" data-trombinoscope-col="" data-display-range-value="true"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@data-js='layout_column']" position="attributes">
            <attribute name="data-exclude" add=".trombinoscope-member" separator=","/>
        </xpath>

        <xpath expr="//div[@data-js='ReplaceMedia']" position="attributes">
            <attribute name="data-exclude" add=".trombinoscope-image" separator=","/>
        </xpath>
    </template>

    <!-- Register asset dynamically-->
    <!-- TODO: Why static register don't work ?? -->
    <record id="yo_trombinoscope_member.s_trombinoscope_member_000_js" model="ir.asset">
        <field name="name">Trombinoscope Member 000 JS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">yo_trombinoscope_member/static/src/snippets/s_trombinoscope_member/000.js</field>
    </record>

    <record id="yo_trombinoscope_member.s_trombinoscope_member_000_scss" model="ir.asset">
        <field name="name">Trombinoscope Member 000 SCSS</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">yo_trombinoscope_member/static/src/snippets/s_trombinoscope_member/000.scss</field>
    </record>

    <record id="yo_trombinoscope_member.s_trombinoscope_member_options_js" model="ir.asset">
        <field name="name">Trombinoscope Member Options JS</field>
        <field name="bundle">website.assets_wysiwyg</field>
        <field name="path">yo_trombinoscope_member/static/src/snippets/s_trombinoscope_member/options.js</field>
    </record>


</odoo>
