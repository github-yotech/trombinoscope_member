<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_details_fields" inherit_id="portal.portal_my_details_fields">
        <xpath expr="//input[@name='name']/.." position="before">
            <div t-if="partner.image_1920" class="mb-3 col-xl-3">
                <img t-attf-src="data:image/png;base64,#{partner.image_1920}" width="128px" height="128px" style="object-fit: cover;"/>
            </div>
            <div t-attf-class="mb-3 #{error.get('image_1920') and 'o_has_error' or ''} col-xl-9">
                <label class="col-form-label" for="image_1920">Load my profile picture</label>
                <input
                    type="file"
                    name="image_1920"
                    accept="image/*"
                    t-attf-class="form-control #{error.get('image_1920') and 'is-invalid' or ''}" />
            </div>
            <div class="clearfix" />
        </xpath>

        <xpath expr="//input[@name='phone']/.." position="after">
            <div class="clearfix" />
            <div t-attf-class="mb-3 #{error.get('description') and 'o_has_error' or ''} col-xl-6">
                <label class="col-form-label" for="description">Description</label>
                <!-- Dont give space in here -->
                <textarea rows="3" maxlength="500" name="description" t-attf-class="form-control #{error.get('description') and 'is-invalid' or ''}"><t t-out="description or partner.description"/></textarea>
            </div>
            <div t-attf-class="mb-3 #{error.get('favorite_quote') and 'o_has_error' or ''} col-xl-6">
                <label class="col-form-label" for="favorite_quote">Favorite Quote</label>
                <input
                    type="text"
                    name="favorite_quote"
                    t-attf-class="form-control #{error.get('favorite_quote') and 'is-invalid' or ''}"
                    t-att-value="favorite_quote or partner.favorite_quote" />
            </div>
        </xpath>

    </template>

    <template id="portal_my_details" inherit_id="portal.portal_my_details">
        <form action="/my/account" position="attributes">
            <attribute name="enctype">multipart/form-data</attribute>
        </form>
    </template>

</odoo>
