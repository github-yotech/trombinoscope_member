<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_trombinoscope" model="ir.ui.view">
        <field name="name">res.partner.view.form.trombinoscope</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group name="trombinoscope_group" string="Trombinoscope">
                    <group>
                        <field name="description" string="Description"/>
                        <field name="favorite_quote" string="Favorite Quote"/>
                        <field name="trombinoscope_ids" widget="many2many_tags" string="Trombinoscopes"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
